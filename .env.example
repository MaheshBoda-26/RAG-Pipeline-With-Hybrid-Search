# =============================================================================
# RAG Pipeline with Hybrid Search - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables below map directly to config.py Settings dataclass.
# Required variables have no default and MUST be set.
# Optional variables have defaults shown in comments.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: NVIDIA API Configuration
# -----------------------------------------------------------------------------
# Get your API key from https://integrate.api.nvidia.com/
# This is required for embeddings and chat completions
NVIDIA_API_KEY=your-nvidia-api-key-here

# NVIDIA NIM base URL (default: NVIDIA's hosted endpoint)
# Change if using self-hosted NIM or different region
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
# Embedding model - MUST match EMBEDDING_DIM dimension
# Options: BAAI/bge-base-en-v1.5 (768 dims), nvidia/nv-embedqa-e5-v5 (1536 dims), sentence-transformers/all-mpnet-base-v2 (768 dims)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Expected embedding dimension - MUST match EMBEDDING_MODEL output
# BAAI/bge-base-en-v1.5 = 768, nvidia/nv-embedqa-e5-v5 = 1536, sentence-transformers/all-mpnet-base-v2 = 768
EMBEDDING_DIM=768

# Chat/rerank model - used for generation and LLM-based reranking
# Options: meta/llama-3.1-70b-instruct, meta/llama-3.1-8b-instruct, etc.
CHAT_MODEL=meta/llama-3.1-70b-instruct

# -----------------------------------------------------------------------------
# Vector Database (Qdrant)
# -----------------------------------------------------------------------------
# Local embedded mode path (used when QDRANT_URL is empty)
# Default: ./qdrant_data
QDRANT_PATH=./qdrant_data

# Remote Qdrant URL for production (enables multi-process access)
# Set to use external Qdrant server instead of embedded mode
# Example: http://qdrant:6333 (Docker) or https://your-qdrant.cloud.qdrant.io
QDRANT_URL=

# Collection name for document vectors
# Default: docs
COLLECTION_NAME=docs

# -----------------------------------------------------------------------------
# Multi-Tenant Configuration
# -----------------------------------------------------------------------------
# Enable multi-tenant mode with per-user Qdrant collections
# When true: each user gets isolated collection (user_<user_id>)
# When false: all users share single collection (COLLECTION_NAME)
# Default: false
ENABLE_MULTI_TENANT=false

# Prefix for user-specific collections in multi-tenant mode
# Default: user_
USER_COLLECTION_PREFIX=user_

# Default user ID for single-tenant / demo mode
# Default: default
DEFAULT_USER_ID=default

# -----------------------------------------------------------------------------
# Chunking Strategy
# -----------------------------------------------------------------------------
# Chunking strategy: fixed | recursive | semantic
# fixed: simple character-based with overlap
# recursive: heading-aware (markdown/HTML) with fallback
# semantic: embedding-based semantic boundaries (requires extra embedding calls)
# Default: recursive
CHUNK_STRATEGY=recursive

# Fixed chunk size in characters (used by fixed and recursive strategies)
# Default: 800
FIXED_CHUNK_SIZE=800

# Fixed chunk overlap in characters
# Default: 120
FIXED_CHUNK_OVERLAP=120

# Semantic similarity threshold for semantic chunking (0.0-1.0)
# Lower = more chunks, higher = fewer larger chunks
# Default: 0.28
SEMANTIC_SIMILARITY_THRESHOLD=0.28

# -----------------------------------------------------------------------------
# Deduplication
# -----------------------------------------------------------------------------
# Cosine similarity threshold for near-duplicate detection (0.0-1.0)
# Higher = stricter dedup, lower = more aggressive dedup
# Default: 0.95
DEDUP_SIMILARITY_THRESHOLD=0.95

# -----------------------------------------------------------------------------
# Hybrid Retrieval Configuration
# -----------------------------------------------------------------------------
# Number of dense vector results to retrieve
# Default: 10
DENSE_TOP_K=10

# Number of sparse (BM25) results to retrieve
# Default: 10
SPARSE_TOP_K=10

# RRF (Reciprocal Rank Fusion) constant k
# Default: 60
RRF_K=60

# Dense weight in RRF fusion (0.0-1.0)
# Default: 0.7
DENSE_WEIGHT=0.7

# Sparse weight in RRF fusion (0.0-1.0)
# Default: 0.3
SPARSE_WEIGHT=0.3

# Candidate pool size for reranking
# Default: 15
RERANK_CANDIDATE_POOL=15

# Final top-K results after reranking
# Default: 5
FINAL_TOP_K=5

# Minimum retrieval confidence threshold (0.0-1.0)
# Below this, the pipeline refuses to answer rather than hallucinate
# Default: 0.35
MIN_RETRIEVAL_CONFIDENCE=0.35

# -----------------------------------------------------------------------------
# Cross-Encoder Reranker (Local)
# -----------------------------------------------------------------------------
# Cross-encoder model for reranking (HuggingFace model ID)
# Default: cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Device for cross-encoder: cpu | cuda
# Default: cpu
CROSS_ENCODER_DEVICE=cpu

# Max sequence length for cross-encoder
# Default: 512
CROSS_ENCODER_MAX_LENGTH=512

# -----------------------------------------------------------------------------
# Redis Query Cache (Optional)
# -----------------------------------------------------------------------------
# Redis URL for semantic query caching
# When set, enables exact + semantic query caching
# Example: redis://localhost:6379 or redis://:password@localhost:6379
# Default: "" (disabled)
REDIS_URL=

# Exact match cache TTL in seconds
# Default: 3600 (1 hour)
CACHE_EXACT_TTL=3600

# Semantic similarity cache TTL in seconds
# Default: 14400 (4 hours)
CACHE_SEMANTIC_TTL=14400

# Distance threshold for semantic cache (0.0-1.0)
# Lower = stricter matching, higher = more cache hits
# Default: 0.1
CACHE_DISTANCE_THRESHOLD=0.1

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Global API key for single-tenant mode (legacy)
# Used when ENABLE_MULTI_TENANT=false
# Default: dev-secret-key (CHANGE IN PRODUCTION!)
API_KEY=dev-secret-key

# JWT secret for token signing (auto-generated if not set)
# MUST be set in production for consistent tokens across restarts
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token expiry in minutes
# Default: 30
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiry in days
# Default: 7
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment: development | production
# Controls cookie Secure flag (true only in production)
# Default: development
ENVIRONMENT=development

# Cookie domain for cross-subdomain auth (optional)
# Example: .example.com
# Default: "" (current host only)
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# File Upload & Ingestion
# -----------------------------------------------------------------------------
# Maximum file upload size in MB
# Default: 10
MAX_FILE_SIZE_MB=10

# Allowed root directory for ingestion (path traversal protection)
# Default: ./sample_docs
ALLOWED_INGEST_ROOT=./sample_docs

# -----------------------------------------------------------------------------
# Supabase Alternative Vector Store (Optional)
# -----------------------------------------------------------------------------
# Enable Supabase/pgvector instead of Qdrant
# Default: false
USE_SUPABASE=false

# Supabase project URL
# Example: https://your-project.supabase.co
SUPABASE_URL=

# Supabase anon key (public)
SUPABASE_ANON_KEY=

# Supabase service role key (secret, for admin operations)
SUPABASE_SERVICE_KEY=

# Supabase direct database URL (for pgvector)
# Example: postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_DB_URL=

# =============================================================================
# EXAMPLE PRODUCTION VALUES (uncomment and customize)
# =============================================================================
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# EMBEDDING_DIM=1536
# CHAT_MODEL=meta/llama-3.1-70b-instruct
# QDRANT_URL=http://qdrant:6333
# ENABLE_MULTI_TENANT=true
# REDIS_URL=redis://redis:6379
# JWT_SECRET=your-64-char-urlsafe-secret-here
# ENVIRONMENT=production
# COOKIE_DOMAIN=.yourdomain.com
# API_KEY=sk-your-production-api-key
# USE_SUPABASE=false
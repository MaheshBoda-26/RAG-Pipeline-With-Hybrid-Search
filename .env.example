# OpenAI API Configuration
# Get your API key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Model Configuration
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant Configuration
# For embedded mode (single process), use QDRANT_PATH
# For external Qdrant server (multi-worker), use QDRANT_URL
# QDRANT_PATH=./qdrant_data
QDRANT_URL=http://qdrant:6333

# Collection Configuration
COLLECTION_NAME=docs
EMBEDDING_DIM=1536

# Chunking Configuration
CHUNK_STRATEGY=recursive  # fixed | recursive | semantic
FIXED_CHUNK_SIZE=800
FIXED_CHUNK_OVERLAP=120
SEMANTIC_SIMILARITY_THRESHOLD=0.28

# Deduplication
DEDUP_SIMILARITY_THRESHOLD=0.95

# Retrieval Configuration
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_K=60
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RERANK_CANDIDATE_POOL=20
FINAL_TOP_K=5

# Confidence Thresholds
MIN_RETRIEVAL_CONFIDENCE=0.35

# API Authentication
API_KEY=your-secure-api-key-here

# Ingestion Path Security
ALLOWED_INGEST_ROOT=./sample_docs
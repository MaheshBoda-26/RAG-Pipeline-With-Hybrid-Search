# NVIDIA NIM API Configuration
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model Configuration (NVIDIA NIM models)
CHAT_MODEL=meta/llama-3.1-70b-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIM=1024

# Qdrant Configuration
# For embedded mode (single process), use QDRANT_PATH
# For external Qdrant server (multi-worker), use QDRANT_URL
QDRANT_PATH=./qdrant_data
# QDRANT_URL=http://qdrant:6333

# Collection Configuration
COLLECTION_NAME=docs

# Multi-tenant Configuration
ENABLE_MULTI_TENANT=true
USER_COLLECTION_PREFIX=user_
DEFAULT_USER_ID=default
# ADMIN_API_KEY=your-admin-api-key-here  # Required for user management endpoints

# Chunking Configuration
CHUNK_STRATEGY=recursive  # fixed | recursive | semantic
FIXED_CHUNK_SIZE=800
FIXED_CHUNK_OVERLAP=120
SEMANTIC_SIMILARITY_THRESHOLD=0.28

# Deduplication
DEDUP_SIMILARITY_THRESHOLD=0.95

# Retrieval Configuration
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_K=60
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RERANK_CANDIDATE_POOL=20
FINAL_TOP_K=5

# Confidence Thresholds
MIN_RETRIEVAL_CONFIDENCE=0.35

# API Authentication
API_KEY=your-secure-api-key-here

# Ingestion Path Security
ALLOWED_INGEST_ROOT=./sample_docs

# Upload Limits
MAX_FILE_SIZE_MB=10

# Backend URL for frontend proxy
RAG_API_URL=http://localhost:8000
RAG_API_KEY=your-secure-api-key-here
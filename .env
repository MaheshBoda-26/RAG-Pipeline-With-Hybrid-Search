# NVIDIA NIM Configuration
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=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

# For OpenAI-compatible endpoint (NVIDIA NIM)
OPENAI_API_KEY=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
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

# Model Configuration
CHAT_MODEL=meta/llama-3.1-70b-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
RERANK_MODEL=meta/llama-3.1-70b-instruct

# Qdrant Configuration
QDRANT_PATH=./qdrant_data
# QDRANT_URL=http://qdrant:6333

# Collection Configuration
COLLECTION_NAME=docs
EMBEDDING_DIM=1024  # nvidia/nv-embedqa-e5-v5 outputs 1024-dim

# Chunking Configuration
CHUNK_STRATEGY=recursive
FIXED_CHUNK_SIZE=800
FIXED_CHUNK_OVERLAP=120
SEMANTIC_SIMILARITY_THRESHOLD=0.28

# Deduplication
DEDUP_SIMILARITY_THRESHOLD=0.95

# Retrieval Configuration
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_K=60
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RERANK_CANDIDATE_POOL=10
FINAL_TOP_K=5

# Confidence Thresholds
MIN_RETRIEVAL_CONFIDENCE=0.35

# API Authentication
API_KEY=your-secure-api-key-here

# Ingestion Path Security
ALLOWED_INGEST_ROOT=./sample_docs